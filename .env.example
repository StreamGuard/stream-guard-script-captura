# Copie este modelo para .env somente se o arquivo privado ainda nao existir.
# O MySQL fornece servidor_id automaticamente; nao configure IDs manualmente.
WEB_DATA_VIZ_URL="http://localhost:3333"
CAPTURA_MODO=real
# Compatibilidade: --modo > CAPTURA_MODO > STREAMGUARD_MODO > real.
# STREAMGUARD_MODO=real
S3_BUCKET=SEU_BUCKET_DE_HOMOLOGACAO
AWS_DEFAULT_REGION=us-east-1
# Apenas localmente, se usar um perfil AWS ja configurado. Na EC2 use a Role.
# AWS_PROFILE=streamguard

# Omitidas/vazias: o agente solicita login no terminal. Nunca publique valores reais.
USUARIO_EMAIL=
USUARIO_SENHA=

# Parametros opcionais usados apenas no modo simulado.
# SIMULACAO_SEMENTE=42
# SIMULACAO_DURACAO_FASE=120
