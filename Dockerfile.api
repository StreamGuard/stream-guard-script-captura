FROM node:22-alpine
WORKDIR /app

# Instala as dependências antes de copiar o restante do código.
COPY package.json ./
RUN npm install --omit=dev

# Copia somente os arquivos operacionais, sem arquivos de ambiente privados.
COPY app.js ./
COPY src ./src
COPY public ./public
USER node
EXPOSE 3333
CMD ["node", "app.js"]
