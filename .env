# Substitua IP_PUBLICO_DA_EC2 pelo IP da instância onde sua API está rodando.
# Se a API estiver no seu próprio computador, use http://localhost:3333.
WEB_DATA_VIZ_URL=http://IP_PUBLICO_DA_EC2:3333

# Substitua pelo nome do bucket que você criou na sua conta AWS.
# Informe somente o nome, sem s3:// e sem subpastas.
S3_BUCKET=NOME_DO_SEU_BUCKET

# Região onde o bucket foi criado.
AWS_DEFAULT_REGION=us-east-1

# Informe o nome do perfil que você configurou no arquivo ~/.aws/credentials.
# Exemplo: se a seção é [streamguard], use AWS_PROFILE=streamguard.
# Na EC2 com função IAM, comente a linha inteira. Não deixe o valor vazio.
AWS_PROFILE=NOME_DO_SEU_PERFIL

# Login cadastrado na aplicação StreamGuard, não na AWS.
# Deixe vazio para informar ao iniciar a captura.
USUARIO_EMAIL=
USUARIO_SENHA=